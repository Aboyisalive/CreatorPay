# Copy to .env and fill in. Never commit .env.

# --- Database (Neon) ---------------------------------------------------------
# Neon dashboard -> Connect. Pooled string (host contains "-pooler") for the app,
# direct string for `prisma migrate`.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require"

# --- Auth --------------------------------------------------------------------
# 32+ characters. Generate with: openssl rand -base64 48
AUTH_SECRET="jfnejrnfjen"

# --- Ecobank (UAT sandbox) ---------------------------------------------------
PAYMENT_PROVIDER=ecobank
ECOBANK_BASE_URL=https://apimuat-gateway.ecobank.com

# Developer portal -> Profile -> subscription key (Ocp-Apim-Subscription-Key)
ECOBANK_KEY_CORE=
# Onboarding credentials issued by Ecobank
ECOBANK_CLIENT_ID=
ECOBANK_PUBLIC_KEY=
ECOBANK_SECRET_KEY=
ECOBANK_SOURCE_CODE=CORP_CIB_MOBILE
ECOBANK_AFFILIATE_CODE=EGH
# Public IP Ecobank whitelisted (your VPS proxy's IP when deployed on Vercel)
ECOBANK_IP_ADDRESS=


# --- Forge 2026 (Access Youth Tech Forge: Xtradot Bank sandbox) ---------------
# Set PAYMENT_PROVIDER=forge. Sandbox only answers from inside the team's
# cluster namespace, so run the app there (see deploy/forge/README.md).
# GATEWAY_KEY is injected from the cluster secret huawei-gateway; never commit it.
GATEWAY_KEY=
FORGE_BANK_BASE_URL=http://bank-api.ingress-apisix.svc.cluster.local/v1
# Pool account debited for payouts (team-owned, e.g. 0123456793 corporate account)
FORGE_SOURCE_ACCOUNT=0123456793
# Returned once by POST /webhooks registration
FORGE_WEBHOOK_SECRET=
